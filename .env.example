# DATABASE_URL: Pooled Postgres connection string.
# Provided automatically when you connect a Postgres integration (e.g. Neon)
# to this project via the Vercel dashboard's Storage tab.
# For local development, run `vercel env pull` to download it into .env.local,
# or paste your own Postgres connection string here.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
