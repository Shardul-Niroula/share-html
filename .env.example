# Postgres connection string.
# Provided automatically when you connect a Postgres integration (e.g. Neon)
# to this project via the Vercel dashboard's Storage tab. Depending on how
# the integration was connected, it may arrive as a plain DATABASE_URL /
# POSTGRES_URL, or under a project-specific prefix (e.g. "<project>_POSTGRES_URL").
# lib/db.ts already scans for either form, so you usually don't need to set
# DATABASE_URL yourself - only do so to override that detection, or for local
# development if you'd rather point at your own Postgres instance:
# DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Neon Auth base URL: injected automatically once you enable Auth on your Neon
# project. It usually arrives under a project-specific prefix rather than as
# VITE_NEON_AUTH_URL directly (e.g. "<projectname>_NEON_AUTH_BASE_URL") -
# vite.config.ts already looks for that automatically, so you shouldn't need
# to set this yourself. Only set VITE_NEON_AUTH_URL explicitly if you want to
# override that detection.
# VITE_NEON_AUTH_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/<db>/auth"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
